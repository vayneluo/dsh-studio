{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-studio",
  "version": "0.1.3",
  "identifier": "com.dsh.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "DS Studio", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "dsh-studio",
    "resources": {
      "../runtime/node/node.exe": "runtime/node/node.exe",
      "../runtime/host": "runtime/host",
      "../runtime/profile-seed": "runtime/profile-seed"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
